{
  "name": "@missioncontrolio/client",
  "description": "The official Node SDK for the Mission:Control Partner API.",
  "license": "ISC",
  "author": "",
  "homepage": "https://github.com/PandoMC/sdk/tree/main/node",
  "repository": "github:PandoMC/sdk",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsc-alias --resolve-full-paths --resolve-full-extension .js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsc-alias": "^1.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@microsoft/kiota-authentication-azure": "^1.0.0-preview.100",
    "@microsoft/kiota-bundle": "^1.0.0-preview.100"
  }
}
